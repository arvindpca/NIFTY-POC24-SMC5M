# TEMPLATE ONLY — replace DUMMY_* values locally. These are not working credentials.
# Never commit a real .env file or share credentials in chat.
# For GitHub Actions, add the real values under Settings > Secrets and variables > Actions.

PAPER_ONLY=true
ANGEL_API_KEY=DUMMY_REPLACE_WITH_ANGEL_API_KEY
ANGEL_CLIENT_CODE=DUMMY_REPLACE_WITH_ANGEL_CLIENT_CODE
ANGEL_PIN=DUMMY_REPLACE_WITH_ANGEL_PIN
ANGEL_TOTP_SECRET=DUMMY_REPLACE_WITH_ANGEL_TOTP_SECRET

# Optional Telegram alerts; configure only if wanted.
TELEGRAM_BOT_TOKEN=DUMMY_OPTIONAL_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=DUMMY_OPTIONAL_TELEGRAM_CHAT_ID

SYMBOL_TOKEN_CSV=config/symbol_tokens.csv
DATA_DIR=data
POLL_SECONDS=30
PAPER_COST_BPS_PER_SIDE=0
